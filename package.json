{
    "name": "@johannes.latzel/llm-chat-mcp",
    "version": "0.2.0",
    "description": "MCP server for llm-chat Tool packages",
    "license": "MIT",
    "sideEffects": false,
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "author": "Johannes B. Latzel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johanneslatzel/llm-chat-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/johanneslatzel/llm-chat-mcp/issues"
    },
    "homepage": "https://github.com/johanneslatzel/llm-chat-mcp#readme",
    "keywords": [
        "llm",
        "chat",
        "mcp",
        "tool"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "verify": "tsc --noEmit && eslint . --max-warnings 0 && vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write 'docs/**/*.md' 'src/**/*.ts' 'tests/**/*.ts'",
        "docs": "docker run --rm -it -p 8000:8000 -v $PWD:/docs squidfunk/mkdocs-material",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean:pack": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify && npm run build && npm pack",
        "clean:install": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify",
        "prepare": "husky",
        "audit": "npm audit --audit-level=high",
        "prebuild": "rm -rf dist/",
        "prepack": "npm run build"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "prettier --write",
            "eslint --max-warnings 0 --no-warn-ignored",
            "vitest related --run"
        ]
    },
    "dependencies": {
        "@johannes.latzel/llm-chat": "^0.7.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "async-mutex": "^0.5.0",
        "express": "^5.2.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "@vitest/coverage-v8": "^4.1.8",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-n": "^17.17.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.5.3",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    }
}
